// AVENIK Phase 1 Foundation Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum ProvenanceType {
  OFFICIAL_SOURCE
  VERIFIED
  CONNECTED_SOURCE
  PROFESSIONALLY_REVIEWED
  USER_REPORTED
  IMPORTED
  CALCULATED
  ESTIMATED
  AI_GENERATED
  UNVERIFIED
}

// ── Models ───────────────────────────────────────

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?    @map("display_name")
  email         String?    @unique
  emailVerified DateTime?  @map("email_verified") @db.Timestamptz
  image         String?    @map("profile_image")
  countryCode   String?    @map("country_code") @db.Char(2)
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  accounts        Account[]
  sessions        Session[]
  profile         UserProfile?
  roles           UserRole[]
  memberships     OrganizationMember[]
  ownedBusinesses Business[]
  auditEvents     AuditEvent[]         @relation("ActorUser")

  // Phase 2 Relations
  ownedGoals          Goal[]
  assignedActions     Action[]
  uploadedDocuments   Document[]
  targetRelationships EcosystemRelationship[] @relation("UserRelationships")
  trustProfile        TrustProfile?
  EcosystemMessage    EcosystemMessage[]
  EntrepreneurDigitalTwin EntrepreneurDigitalTwin[]
  AgentTask               AgentTask[]

  @@index([email])
  @@index([countryCode])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserProfile {
  userId       String   @id @map("user_id") @db.Uuid
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  bio          String?
  profileImage String?  @map("profile_image")
  timezone     String?  @default("Asia/Kolkata")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Organization {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  countryCode String?            @map("country_code") @db.Char(2)
  status      OrganizationStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members     OrganizationMember[]
  businesses  Business[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  membershipRole String   @map("membership_role")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_members")
}

model Business {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  ownerUserId      String?   @map("owner_user_id") @db.Uuid
  legalName        String?   @map("legal_name")
  displayName      String    @map("display_name")
  countryCode      String?   @map("country_code") @db.Char(2)
  organizationType String?   @map("organization_type")
  businessStatus   String?   @map("business_status")
  foundedAt        DateTime? @map("founded_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerUser    User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  // Phase 2 Relations
  goals                   Goal[]
  actions                 Action[]
  recommendations         Recommendation[]
  decisions               Decision[]
  timelineEvents          TimelineEvent[]
  memories                Memory[]
  fundingRequests         FundingRequest[]
  verificationClaims      VerificationClaim[]
  fraudCases              FraudCase[]
  healthRecords           BusinessHealth[]
  earlyWarnings           EarlyWarning[]
  forecasts               Forecast[]
  financialRecords        FinancialRecord[]
  opportunityEngagements  OpportunityEngagement[]
  intents                 EntrepreneurIntent[]
  opportunityMatchResults OpportunityMatchResult[]
  risks                   Risk[]
  documents               Document[]
  trustProfile            TrustProfile?

  // Ecosystem Relations
  sourceRelationships     EcosystemRelationship[]   @relation("SourceRelationships")
  targetRelationships     EcosystemRelationship[]   @relation("TargetRelationships")
  CommercialExpansionPlan CommercialExpansionPlan[]
  CapabilityGap           CapabilityGap[]
  WorkforceCapacity       WorkforceCapacity[]
  OperationalRisk         OperationalRisk[]
  GrowthScenario          GrowthScenario[]
  ProactiveInsight        ProactiveInsight[]
  AgentExecution          AgentExecution[]

  // Phase 12 Relations
  EntrepreneurDigitalTwin EntrepreneurDigitalTwin[]
  AnomalyDetection        AnomalyDetection[]
  InnovationRecord        InnovationRecord[]
  GovernancePolicy        GovernancePolicy[]

  // Phase 13 Relations
  IntelligenceSignal      IntelligenceSignal[]
  AgentTask               AgentTask[]
  StrategicSimulation     StrategicSimulation[]
  CompetitiveIntel        CompetitiveIntel[]

  @@index([ownerUserId])
  @@index([organizationId])
  @@map("businesses")
}

model ProvenanceRecord {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provenance      ProvenanceType
  sourceName      String?        @map("source_name")
  sourceUrl       String?        @map("source_url")
  sourceReference String?        @map("source_reference")
  sourceVersion   String?        @map("source_version")
  verifiedAt      DateTime?      @map("verified_at") @db.Timestamptz
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("provenance_records")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  purpose        String?
  result         String
  ipAddress      String?  @map("ip_address") // Maps to INET in Postgres if we use raw, but String in Prisma is fine for now
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  actorUser    User?         @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_events")
}

// Phase 2 Schema Additions
// Unified Business State, Goals, Actions, Health, Finance, Ecosystem, Government, etc.

// -----------------------------------------
// E. GOAL OPERATING SYSTEM
// -----------------------------------------
model Goal {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String    @map("business_id") @db.Uuid
  ownerUserId         String    @map("owner_user_id") @db.Uuid
  parentGoalId        String?   @map("parent_goal_id") @db.Uuid
  title               String
  description         String?
  category            String // FINANCIAL, PRODUCT, MARKET, COMPLIANCE, SUSTAINABILITY, etc.
  type                String    @default("GOAL") // GOAL, OBJECTIVE, MILESTONE
  source              String? // USER, SYSTEM, RECOMMENDATION
  provenance          String? // RULE_BASED, CALCULATED, USER_REPORTED
  status              String    @default("DRAFT") // DRAFT, ACTIVE, ON_TRACK, AT_RISK, COMPLETED, ABANDONED
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  startDate           DateTime? @map("start_date") @db.Timestamptz
  targetDate          DateTime? @map("target_date") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  baseline            Float?
  target              Float?
  currentValue        Float     @default(0) @map("current_value")
  unit                String?
  progress            Float     @default(0)
  confidence          Int? // 0-100
  evidenceRequirement String?   @map("evidence_requirement")
  riskLevel           String    @default("LOW") @map("risk_level") // LOW, MEDIUM, HIGH
  visibility          String    @default("PRIVATE") // PRIVATE, TEAM, PUBLIC
  sensitivity         String    @default("NORMAL") // NORMAL, CONFIDENTIAL
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  business  Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerUser User         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  parent    Goal?        @relation("GoalToGoal", fields: [parentGoalId], references: [id], onDelete: Cascade)
  children  Goal[]       @relation("GoalToGoal")
  actions   Action[]
  metrics   GoalMetric[]
  risks     Risk[]

  @@index([businessId, status])
  @@index([parentGoalId])
  @@map("goals")
}

model GoalMetric {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId       String   @map("goal_id") @db.Uuid
  name         String
  targetValue  Float    @map("target_value")
  currentValue Float    @default(0) @map("current_value")
  unit         String?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_metrics")
}

// -----------------------------------------
// G. EXECUTION ENGINE (Unified Actions)
// -----------------------------------------
model Action {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String    @map("business_id") @db.Uuid
  goalId              String?   @map("goal_id") @db.Uuid
  assigneeUserId      String?   @map("assignee_user_id") @db.Uuid
  title               String
  description         String?
  type                String    @default("ACTION") // ACTION, CHECKLIST_ITEM
  status              String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE, BLOCKED, CANCELLED
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate             DateTime? @map("due_date") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  source              String? // USER, AI_RECOMMENDATION, APPLICATION, COMPLIANCE
  provenance          String?
  evidenceRequirement String?   @map("evidence_requirement")
  visibility          String    @default("PRIVATE")
  executionPlan       String?   @map("execution_plan") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goal         Goal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  assigneeUser User?              @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)
  dependencies ActionDependency[] @relation("DependentAction")
  blocks       ActionDependency[] @relation("BlockingAction")

  @@index([businessId, status])
  @@index([assigneeUserId, status])
  @@map("actions")
}

model ActionDependency {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionId          String   @map("action_id") @db.Uuid
  dependsOnActionId String   @map("depends_on_action_id") @db.Uuid
  type              String   @default("BLOCKS") // BLOCKS, RELATES_TO
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  action          Action @relation("DependentAction", fields: [actionId], references: [id], onDelete: Cascade)
  dependsOnAction Action @relation("BlockingAction", fields: [dependsOnActionId], references: [id], onDelete: Cascade)

  @@unique([actionId, dependsOnActionId])
  @@map("action_dependencies")
}

// -----------------------------------------
// H. NEXT-BEST-ACTION (Recommendations)
// -----------------------------------------
model Recommendation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  title           String
  description     String    @db.Text
  category        String // FINANCE, COMPLIANCE, SALES, GOVERNMENT, LEARNING
  confidenceScore Float     @map("confidence_score") // 0.0 - 1.0
  urgencyScore    Float     @map("urgency_score") // 0.0 - 1.0
  relevanceScore  Float?    @map("relevance_score") // 0.0 - 1.0
  impactScore     Float?    @map("impact_score") // 0.0 - 1.0
  riskScore       Float?    @map("risk_score") // 0.0 - 1.0
  status          String    @default("ACTIVE") // ACTIVE, DISMISSED, CONVERTED_TO_TASK, EXPIRED, ACCEPTED, DECLINED, SNOOZED
  explanation     String?   @db.Text
  sourceAiModel   String?   @map("source_ai_model")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@index([businessId, status])
  @@map("recommendations")
}

// -----------------------------------------
// I. BUSINESS HEALTH & FORECASTING
// -----------------------------------------
model BusinessHealth {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  dimension       String // OVERALL, FINANCIAL, CUSTOMER, OPERATIONS, COMPLIANCE
  score           Float // 0.0 - 100.0
  financialScore  Float?   @map("financial_score")
  riskScore       Float?   @map("risk_score")
  operationsScore Float?   @map("operations_score")
  ecosystemScore  Float?   @map("ecosystem_score")
  aiInsights      String?  @map("ai_insights") @db.Text
  trend           String // UP, DOWN, STABLE
  evidence        String?  @db.Text
  calculatedAt    DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dimension, calculatedAt(sort: Desc)])
  @@map("business_health")
}

model Forecast {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  metricName      String   @map("metric_name") // REVENUE, CASH_FLOW, BURN_RATE
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  predictedValue  Float    @map("predicted_value")
  confidenceLower Float?   @map("confidence_lower")
  confidenceUpper Float?   @map("confidence_upper")
  assumptions     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("forecasts")
}

// -----------------------------------------
// K. FINANCIAL INTELLIGENCE
// -----------------------------------------
model FinancialRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  type            String // INFLOW, OUTFLOW
  category        String // REVENUE, EXPENSE, DEBT, INVESTMENT
  amount          Float
  currency        String   @default("INR") @db.Char(3)
  transactionDate DateTime @map("transaction_date") @db.Date
  status          String   @default("COMPLETED") // PENDING, COMPLETED, RECONCILED
  description     String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, transactionDate])
  @@map("financial_records")
}

// -----------------------------------------
// COMMERCE & EXPANSION (PHASE 10.5)
// -----------------------------------------
model CommercialExpansionPlan {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  targetMarket     String   @map("target_market") // e.g., 'EU', 'US_ENTERPRISE'
  status           String   @default("EVALUATING") // EVALUATING, APPROVED, EXECUTING, PAUSED
  viabilityScore   Float?   @map("viability_score")
  investmentNeeded Float?   @map("investment_needed")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  segments         CustomerSegment[]
  pricingScenarios PricingScenario[]

  @@index([businessId, status])
  @@map("commercial_expansion_plans")
}

model CustomerSegment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  name      String
  size      Int?
  readiness String   @default("UNKNOWN") // HIGH, MEDIUM, LOW, UNKNOWN
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  plan CommercialExpansionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("customer_segments")
}

model PricingScenario {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  currency        String   @db.Char(3)
  pricePoint      Float    @map("price_point")
  projectedMargin Float?   @map("projected_margin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  plan CommercialExpansionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("pricing_scenarios")
}

// -----------------------------------------
// WORKFORCE & CAPABILITY (PHASE 10.6)
// -----------------------------------------
model CapabilityGap {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  skillName     String   @map("skill_name")
  currentLevel  Int      @map("current_level")
  requiredLevel Int      @map("required_level")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("capability_gaps")
}

model WorkforceCapacity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  roleName    String   @map("role_name")
  currentFTE  Float    @map("current_fte")
  requiredFTE Float    @map("required_fte")
  overloaded  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("workforce_capacities")
}

// -----------------------------------------
// OPERATIONS & RESILIENCE (PHASE 10.7)
// -----------------------------------------
model OperationalRisk {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  riskArea   String   @map("risk_area")
  severity   String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  mitigated  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("operational_risks")
}

// -----------------------------------------
// STRATEGY & SCENARIO (PHASE 10.8)
// -----------------------------------------
model GrowthScenario {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  scenarioName     String   @map("scenario_name")
  projectedRevenue Float    @map("projected_revenue")
  probability      Float    @default(0.5)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("growth_scenarios")
}

// -----------------------------------------
// PHASE 11: ADAPTIVE INTELLIGENCE
// -----------------------------------------
model ProactiveInsight {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  domain      String // FINANCE, WORKFORCE, STRATEGY, ECOSYSTEM, etc.
  title       String
  description String
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  urgency     String // LOW, MEDIUM, HIGH, URGENT
  impactScore Float    @map("impact_score")
  confidence  Float
  status      String   @default("UNREAD") // UNREAD, ACKNOWLEDGED, ACTIONED, DISMISSED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("proactive_insights")
}

model AgentExecution {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  requestedBy   String    @map("requested_by") @db.Uuid // User ID
  actionName    String    @map("action_name")
  autonomyLevel Int       @map("autonomy_level") // 0-6
  status        String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, EXECUTING, SUCCESS, FAILED, BLOCKED_BY_SAFETY
  safetyReason  String?   @map("safety_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  executedAt    DateTime? @map("executed_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("agent_executions")
}

// T. GOVERNMENT SUPPORT EXECUTION
// -----------------------------------------

model EntrepreneurIntent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  rawQuery             String   @map("raw_query") @db.Text
  sector               String?
